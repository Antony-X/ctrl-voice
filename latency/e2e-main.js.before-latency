    if (ch !== 'rec:state') { events.push({ t: Date.now() - T0, ch, brief }); log('-> hub', ch, brief ?? ''); }
    return origSend(ch, payload);
  };

  // Record every toast the hub shows.
  await R(`window.__toasts = []; { const t = toast; window.toast = (text, bad = false) => { __toasts.push({ text, bad, t: Date.now() }); t(text, bad); }; } true`);

