// ---------- 1b. engine unreachable: record, save locally, open with a notice ----------
async function stepOffline() {
  const before = listMsgs().length;
  const tStart = Date.now();
  M.toggleRecording();
  await sleep(1500);
  const rec = await O(`({ cap: capText.textContent, note: document.getElementById('capNote').textContent })`);
  log('overlay', rec);
  await sleep(4000);
  const tStop = Date.now();
  M.toggleRecording();
  let last = '', procTexts = [];
  while (Date.now() - tStop < 15000) {
    const s = await O(`({ pill: pill.className, proc: document.getElementById('procText').textContent })`);
    if (s.proc + s.pill !== last) { log('overlay', s); procTexts.push(s); last = s.proc + s.pill; }
    if (/idle/.test(s.pill)) break;
    await sleep(200);
  }
  const done = await waitFor(() => events.find(e => e.ch === 'edit:status' && e.brief.text === null && e.t > tStop - T0), 60000, 200);
  await sleep(800);
  const ids = listMsgs().map(f => f.replace(/\.json$/, ''));
  const metas = ids.map(id => JSON.parse(fs.readFileSync(path.join(messagesDir(), `${id}.json`), 'utf8')));
  const meta = metas.sort((a, b) => b.createdAt - a.createdAt)[0];
  const wav = meta && path.join(messagesDir(), `${meta.id}.wav`);
  const wavBytes = wav && fs.existsSync(wav) ? fs.statSync(wav).size : 0;
  const hub = await R(`({ route: S.route, id: S.id, fixing: S.fixing, notice: S.notice, words: document.querySelectorAll('#transcript .w').length, empty: !!document.querySelector('.transcript-empty'), retry: !!document.querySelector('[data-action="retry"]'), outDur: S.audio.output && S.audio.output.dur })`);
  log('offline hub', hub, { wavBytes, sid: meta?.sid, dur: meta?.dur });
  record('offline: overlay says engine offline', /offline/i.test(rec.note), rec);
  record('offline: recording saved locally', listMsgs().length === before + 1 && wavBytes > 44 + 24000 * 2 * 4 && meta.sid === null, { wavBytes, dur: meta?.dur });
  record('offline: overlay ends with a true result', procTexts.some(p => /Opened in Ctrl\+Voice/.test(p.proc)) && !procTexts.some(p => /Saved in Ctrl\+Voice/.test(p.proc)), { procTexts });
  record('offline: editor shows the fix error with Try again', hub.route === 'editor' && hub.id === meta?.id && !hub.fixing && !!hub.notice && hub.retry, { notice: hub.notice, fixError: done?.brief.error });
  record('offline: original audio playable', hub.outDur > 4, { outDur: hub.outDur });
  await screenshot('offline-editor');
  const health = await R(`api.invoke('engine:health')`);
  record('offline: health check reports it', health.ok === false, health);
}

// ---------- 3. cancel leaves nothing ----------
async function stepCancel() {
  const before = listMsgs().length;
  M.toggleRecording();
  await sleep(3500);
  const rec = await O(`pill.className`);
  ipcMain.emit('rec:cancel');
  await sleep(2500);
  const after = listMsgs().length;
  const pillAfter = await O(`pill.className`);
  record('cancel leaves no message', after === before && /rec/.test(rec) && /idle/.test(pillAfter), { before, after, rec, pillAfter });
}
