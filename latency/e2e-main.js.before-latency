const M = require(`${CV}/src/main/main.js`);
for (const k of Object.keys(M.SEND_APPS)) delete M.SEND_APPS[k]; // never a send target

const results = [];
const record = (step, ok, info) => { results.push({ step, ...info, ok }); log(ok ? 'PASS' : 'FAIL', step, info); };
const sleep = (ms) => new Promise(r => setTimeout(r, ms));

let mainWin, overlay;
const events = []; // what main sends to the main window
const consoleErrors = [];

function hookWindow(win, name) {
  win.webContents.on('console-message', (_e, level, message, line, src) => {
    const s = `[${name}:${level}] ${message} (${path.basename(src || '')}:${line})`;
    if (level >= 2) consoleErrors.push(s);
    log(s);
  });
  win.webContents.on('render-process-gone', (_e, d) => log(`[${name}] RENDERER GONE`, d));
  win.webContents.on('preload-error', (_e, p, err) => log(`[${name}] PRELOAD ERROR`, p, String(err)));
}

async function quit(code) {
  log('RESULTS', results.map(r => `${r.ok ? 'PASS' : 'FAIL'} ${r.step}`));
  fs.writeFileSync(path.join(OUT, `results-${runId}.json`), JSON.stringify({ results, consoleErrors, events }, null, 2));
  try { M.helper.stop(); } catch {}
  app.isQuitting = true;
  setTimeout(() => app.exit(code), 3000);
  app.quit();
}
setTimeout(() => { log('GLOBAL TIMEOUT'); quit(2); }, 9 * 60e3);

const R = (js) => mainWin.webContents.executeJavaScript(js, true);
const O = (js) => overlay.webContents.executeJavaScript(js, true);

async function waitFor(fn, timeout, every = 250) {
  const t = Date.now();
  while (Date.now() - t < timeout) {
    const v = await fn();
    if (v) return v;
    await sleep(every);
  }
  return null;
}

app.whenReady().then(async () => {
  // main.js's whenReady ran first and made its windows
  await sleep(300);
  const wins = BrowserWindow.getAllWindows();
  log('windows', wins.map(w => w.getBounds()));
  await waitFor(() => wins.every(w => w.webContents.getURL() && !w.webContents.isLoading()), 15000);
  mainWin = wins.find(w => /app[\\/]index\.html/.test(decodeURIComponent(w.webContents.getURL())));
  overlay = wins.find(w => /overlay\.html/.test(w.webContents.getURL()));
  if (!mainWin || !overlay) { log('windows not found', wins.map(w => w.webContents.getURL())); return quit(3); }
  hookWindow(mainWin, 'hub');
  hookWindow(overlay, 'overlay');

  // Keep everything off-screen and unfocused: the real showMain() calls show() + focus().
  mainWin.setSkipTaskbar(true);
  mainWin.setBounds({ x: -4000, y: 0, width: 1180, height: 780 });
  mainWin.show = () => mainWin.showInactive();
  mainWin.focus = () => {};
