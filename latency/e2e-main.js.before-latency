const runId = new Date().toISOString().replace(/[:.]/g, '-');
const LOG = path.join(OUT, `e2e-${runId}.log`);
const T0 = Date.now();
const ts = () => ((Date.now() - T0) / 1000).toFixed(2).padStart(7);
function log(...a) {
  const line = `[${ts()}] ${a.map(x => (typeof x === 'string' ? x : JSON.stringify(x))).join(' ')}`;
  process.stdout.write(line + '\n');
  fs.appendFileSync(LOG, line + '\n');
}
for (const k of ['error', 'warn']) {
  const orig = console[k];
  console[k] = (...a) => { log(`[main:${k}]`, ...a.map(x => (x instanceof Error ? `${x.name}: ${x.message}` : x))); orig(...a); };
}
process.on('uncaughtException', (e) => log('[main:uncaught]', e.stack || String(e)));
process.on('unhandledRejection', (e) => log('[main:unhandled]', e?.stack || String(e)));

